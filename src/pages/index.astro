---
import Layout from '../layouts/Layout.astro';
import { site, href, asset } from '../site';

// 게임 소개 (2026-11-26 슬롯 디펜스 기준). 게임 규칙이 바뀌면 여기 문구도 같이 고친다.
//   그림은 우리가 만든 것만 쓴다 (심볼, 카지노 섬, 몬스터, 로고). 구매한 UI 키트가 들어간 그림은 이 공개 저장소에 넣지 않는다
const features = [
  { img: 'slot/slot_seven.png', title: '30칸이 한꺼번에 돈다', text: '판의 모든 칸이 슬롯머신처럼 돌고, 멈춘 자리의 심볼이 몬스터를 막아요.' },
  { img: 'slot/slot_dice.png', title: '같은 심볼 세 개면 한 줄', text: '가로, 세로, 대각선으로 같은 심볼이 이어지면 강해져요. 가운데 초록 칸은 두 배예요.' },
  { img: 'slot/slot_bell.png', title: '잠그고 다시 돌리기', text: '좋은 칸은 잠가 두고 나머지만 다시 돌려요. 칸 하나만 노려서 돌릴 수도 있어요.' },
  { img: 'slot/boss_c3_0.png', title: '카지노 네 곳과 보스', text: '초록 펠트 살롱부터 마왕의 하이롤러 룸까지. 카지노마다 규칙과 보스가 달라요.' },
  { img: 'slot/slot_wheel.png', title: '판이 끝나도 성장', text: '골드로 심볼을 강화하고 훈장으로 카지노 특전을 올려요. 새 심볼도 하나씩 열려요.' },
  { img: 'art/region_jackpot.png', title: '끝없는 잭팟 탑', text: '네 카지노를 깼다면 끝없이 올라가는 탑과 주간 랭킹에서 기록에 도전하세요.' },
];
const symbols = [
  { img: 'slot_dice', label: '주사위 기사' },
  { img: 'slot_card', label: '카드 마술사' },
  { img: 'slot_chip', label: '칩 폭탄' },
  { img: 'slot_ice', label: '얼음 큐브' },
  { img: 'slot_king', label: '킹 카드' },
  { img: 'slot_slotm', label: '슬롯머신' },
  { img: 'slot_wheel', label: '룰렛 휠' },
];
---
<Layout title={`${site.name} - 슬롯 디펜스`} description="판의 30칸이 슬롯머신처럼 돌고, 멈춘 심볼이 몰려오는 몬스터를 막아내는 캐주얼 디펜스 게임." page="">
  <section class="hero">
    <img class="isle i1" src={asset('art/region_neon.png')} alt="" />
    <img class="isle i2" src={asset('art/region_jackpot.png')} alt="" />
    <img class="isle i3" src={asset('art/region_felt.png')} alt="" />
    <img class="isle i4" src={asset('art/region_demon.png')} alt="" />
    <div class="hero-in">
      <img class="logo" src={asset('logo.png')} alt={site.name} />
      <p class="tagline">돌리고, 맞추고, 막아라!</p>
      <p class="sub">판의 30칸이 슬롯머신처럼 돌아요. 같은 심볼을 한 줄로 맞추고, 좋은 칸은 잠그고, 몰려오는 몬스터를 막아내는 캐주얼 디펜스 게임이에요.</p>
      <div class="badges">
        <span class="badge"><span><small>곧 출시</small>App Store</span></span>
        <span class="badge"><span><small>곧 출시</small>Google Play</span></span>
      </div>
      <p class="note">iPhone, Android 출시 준비 중이에요</p>
    </div>
  </section>

  <section class="section">
    <h2>이런 게임이에요</h2>
    <p class="lead">한 판은 짧게, 성장은 길게. 운이 좋으면 잭팟, 운이 없어도 잠그기와 다시 돌리기로 버텨요.</p>
    <div class="features">
      {features.map((f) => (
        <div class="card">
          <img src={asset(f.img)} alt="" loading="lazy" />
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>몬스터를 막는 심볼</h2>
    <p class="lead">주사위, 카드, 칩, 얼음, 룰렛 휠까지. 카지노를 깰 때마다 새 심볼이 열려요.</p>
    <div class="grades">
      {symbols.map((g) => (
        <div class="grade">
          <img src={asset(`slot/${g.img}.png`)} alt="" loading="lazy" />
          <span>{g.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="cta">
    <p>궁금한 점이 있으면 언제든 물어보세요</p>
    <a class="badge go" href={href('support')}><span>문의하기</span></a>
  </section>
</Layout>
